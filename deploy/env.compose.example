# Docker Compose environment template. Copy to .env in the project root.
# The Compose file also reads MONGO_ROOT_* for MongoDB initialization.

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

ALLOWED_ORIGINS=https://cosmic.example.com
APP_PUBLIC_URL=https://cosmic.example.com

# Use the Compose service name `mongo`, not localhost.
# URL-encode special characters in the password, or use a long alphanumeric password.
MONGO_ROOT_USERNAME=cosmic_root
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM
MONGODB_URI=mongodb://cosmic_root:CHANGE_ME_LONG_RANDOM@mongo:27017/cosmic_spider?authSource=admin
MONGODB_TLS=false

SESSION_COOKIE_NAME=cs_session
SESSION_TTL_DAYS=7
TRUST_PROXY=true
SECURE_COOKIES=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Cosmic Spider <no-reply@cosmic.example.com>"

MAX_CONNECTIONS_PER_IP=12
MAX_CONNECTIONS=1000
LOG_LEVEL=info
