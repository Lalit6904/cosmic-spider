# Production environment template for a bare-metal or Nginx-fronted deployment.
# Copy to .env, replace every CHANGE_ME value, and keep it out of source control.

NODE_ENV=production
PORT=3001
HOST=127.0.0.1

# Must be the exact HTTPS site origin. No paths, no trailing slash.
ALLOWED_ORIGINS=https://cosmic.example.com
APP_PUBLIC_URL=https://cosmic.example.com

# Dedicated least-privilege database user. URL-encode special characters.
MONGODB_URI=mongodb://cosmic_app:CHANGE_ME@127.0.0.1:27017/cosmic_spider?authSource=admin
MONGODB_TLS=false

SESSION_COOKIE_NAME=cs_session
SESSION_TTL_DAYS=7
TRUST_PROXY=true
SECURE_COOKIES=true

# Required in production by the environment guard.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Cosmic Spider <no-reply@cosmic.example.com>"

MAX_CONNECTIONS_PER_IP=12
MAX_CONNECTIONS=1000
LOG_LEVEL=info
