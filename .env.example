# Runtime
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Comma-separated exact browser origins allowed to use HTTP and Socket.IO.
# In production this must be the HTTPS site origin (for example https://cosmic.example.com).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# MongoDB. Use a dedicated least-privilege user and TLS in production.
MONGODB_URI=mongodb://127.0.0.1:27017/cosmic_spider
MONGODB_TLS=false

# Session and CSRF secrets are generated credentials, not passwords. Keep them out of source control.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_NAME=cs_session
SESSION_TTL_DAYS=7

# Set true only when the app is behind a trusted reverse proxy that sanitizes X-Forwarded-*.
TRUST_PROXY=false
# Set true in production (requires HTTPS at the proxy).
SECURE_COOKIES=false

# SMTP for password reset delivery. If unset in development, reset links are written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cosmic Spider <no-reply@example.com>"
APP_PUBLIC_URL=http://localhost:5173

# Limits (override only with a measured reason)
MAX_CONNECTIONS_PER_IP=12
MAX_CONNECTIONS=1000
LOG_LEVEL=info
